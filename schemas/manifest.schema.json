{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigo.example/schemas/manifest.schema.json",
  "title": "Certigo Content Manifest",
  "description": "Immutable, hash-addressable manifest of a certigo-content content set. See docs/adr/ADR-0001-content-manifest-immutable.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "canonicalization",
    "itemCount",
    "items",
    "manifestId",
    "rootHash"
  ],
  "properties": {
    "schema": { "const": "certigo.content.manifest/v1" },
    "algorithm": { "const": "sha256" },
    "canonicalization": { "type": "string", "minLength": 1 },
    "itemCount": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "id", "path", "hash", "size"],
        "properties": {
          "channel": { "enum": ["public", "answerKey"] },
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^content/" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "manifestId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rootHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
