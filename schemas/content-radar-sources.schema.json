{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigo.local/schemas/content-radar-sources.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providers"],
  "properties": {
    "schemaVersion": {"const": "certigo.content-radar-sources/v1"},
    "providers": {
      "type": "array",
      "minItems": 35,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "officialDomains", "discoveryEndpoints", "cadenceMinutes", "ingestionStages"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 150},
          "category": {"enum": ["cloud-hyperscalers", "ai-foundation-models", "apple-mobile", "data-analytics", "devops-cloud-native-dev", "cybersecurity-networking", "enterprise-delivery"]},
          "officialDomains": {
            "description": "Exact HTTPS origins; no implicit subdomain or redirect trust.",
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "format": "uri", "pattern": "^https://[a-z0-9.-]+$"}
          },
          "discoveryEndpoints": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "url", "format"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "format": {"enum": ["html-links", "json-items", "blueprint"]},
                "itemUrl": {"type": "string", "format": "uri", "pattern": "^https://"}
              },
              "if": {"properties": {"format": {"const": "blueprint"}}, "required": ["format"]},
              "then": {"properties": {"itemUrl": true}, "required": ["itemUrl"]},
              "else": {"properties": {"itemUrl": false}}
            }
          },
          "cadenceMinutes": {"type": "integer", "minimum": 15, "maximum": 60},
          "ingestionStages": {
            "const": ["stage1_announced_card", "stage2_blueprint_and_pack"]
          }
        }
      }
    }
  }
}
