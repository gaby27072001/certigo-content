{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigo.microsoft.com/schemas/coverage-matrix.schema.json",
  "title": "Certigo certification coverage matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "certification",
    "blueprintVersion",
    "status",
    "objectives"
  ],
  "properties": {
    "schema": {
      "const": "certigo.coverage-matrix/v1"
    },
    "provider": {
      "enum": ["aws", "gcp", "microsoft"]
    },
    "certification": {
      "type": "string",
      "pattern": "^(aws|gcp|microsoft):[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "blueprintVersion": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "status": {
      "enum": ["planned", "in-progress", "complete", "retiring", "retired"]
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective",
          "title",
          "weightPercent",
          "weightType",
          "questionIds"
        ],
        "properties": {
          "objective": {
            "type": "string",
            "pattern": "^(domain|section)-[1-9][0-9]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "weightPercent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "weightType": {
            "enum": ["exact", "approximate"]
          },
          "questionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^((aws|gcp|microsoft)\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]{3}|[a-z][a-z0-9]*(?:-[a-z0-9]+)+)$"
            }
          }
        }
      }
    }
  }
}
