{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigo.microsoft.com/schemas/editorial-track-solutions.schema.json",
  "title": "CertiGo flagship editorial track private answer key",
  "description": "Private answer key and pedagogical rationales for editorial/tracks/*.json, stored under content/answerKey/editorial/tracks/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trackId", "brand", "kind", "solutions"],
  "properties": {
    "schema": { "const": "certigo.editorial.track-solutions/v1" },
    "trackId": { "$ref": "#/$defs/slug" },
    "brand": { "const": "CertiGo" },
    "kind": { "const": "answerKey" },
    "solutions": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/solution" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lessonId",
        "itemType",
        "correctOptionIds",
        "rationale",
        "examTip",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]{3}$"
        },
        "lessonId": { "$ref": "#/$defs/slug" },
        "itemType": {
          "enum": ["mcq", "scenario", "spotTheIssue"]
        },
        "correctOptionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "rationale": { "$ref": "#/$defs/text" },
        "examTip": { "$ref": "#/$defs/text" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    }
  }
}
