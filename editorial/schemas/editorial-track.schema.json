{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigo.microsoft.com/schemas/editorial-track.schema.json",
  "title": "CertiGo flagship editorial training track (modules, lessons, Cartes Declic, schemas, and public questions)",
  "description": "Closed editorial track authoring contract for CertiGo multi-provider AI & business curricula. Public track files forbid answer-bearing keys; matching solutions live under content/answerKey/editorial/tracks/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "brand",
    "providerId",
    "radarTrackId",
    "routeCode",
    "routeAliases",
    "brandIdentity",
    "locale",
    "status",
    "title",
    "subtitle",
    "audience",
    "prerequisites",
    "estimatedMinutes",
    "asOf",
    "sources",
    "modules",
    "mockExam"
  ],
  "properties": {
    "schema": { "const": "certigo.editorial.track/v1" },
    "id": { "$ref": "#/$defs/slug" },
    "brand": { "const": "CertiGo" },
    "providerId": { "enum": ["microsoft", "openai", "anthropic", "harvey"] },
    "radarTrackId": {
      "enum": [
        "microsoft:m365-copilot",
        "openai:chatgpt-codex-agents",
        "anthropic:claude-code-mcp",
        "harvey:legal-ai-platform"
      ]
    },
    "routeCode": {
      "enum": ["MS-4004", "OPENAI-CODEX", "CLAUDE-MCP", "HARVEY-LEGAL"]
    },
    "routeAliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
      }
    },
    "brandIdentity": { "$ref": "#/$defs/brandIdentity" },
    "locale": { "const": "fr-FR" },
    "status": { "enum": ["active", "draft"] },
    "title": { "$ref": "#/$defs/text" },
    "subtitle": { "$ref": "#/$defs/text" },
    "audience": { "$ref": "#/$defs/text" },
    "prerequisites": { "$ref": "#/$defs/text" },
    "estimatedMinutes": { "type": "integer", "minimum": 15, "maximum": 240 },
    "asOf": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/source" }
    },
    "modules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/module" }
    },
    "mockExam": { "$ref": "#/$defs/mockExam" }
  },
  "$defs": {
    "brandIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logoSlug", "displayName", "primaryHex", "accentHex", "masteryModel"],
      "properties": {
        "logoSlug": { "enum": ["microsoft", "openai", "anthropic", "harvey"] },
        "displayName": { "$ref": "#/$defs/text" },
        "primaryHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accentHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "masteryModel": { "$ref": "#/$defs/text" }
      }
    },
    "mockExam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "durationMinutes", "passingScorePercent", "scenarioBrief", "questionIds"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/text" },
        "durationMinutes": { "type": "integer", "minimum": 10, "maximum": 120 },
        "passingScorePercent": { "type": "integer", "minimum": 60, "maximum": 100 },
        "scenarioBrief": { "$ref": "#/$defs/text" },
        "questionIds": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]{3}$"
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "checkedOn", "supports", "limits"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/text" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "checkedOn": { "type": "string", "format": "date" },
        "supports": { "$ref": "#/$defs/text" },
        "limits": { "$ref": "#/$defs/text" }
      }
    },
    "schemaComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" }
      }
    },
    "architectureSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "diagram", "components", "securityInvariant"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "diagram": { "$ref": "#/$defs/text" },
        "components": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/schemaComponent" }
        },
        "securityInvariant": { "$ref": "#/$defs/text" }
      }
    },
    "declicCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "diagramTop", "diagramBottom", "step1", "step2", "rule"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "diagramTop": { "$ref": "#/$defs/text" },
        "diagramBottom": { "$ref": "#/$defs/text" },
        "step1": { "$ref": "#/$defs/text" },
        "step2": { "$ref": "#/$defs/text" },
        "rule": { "$ref": "#/$defs/text" }
      }
    },
    "microSlide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepBadge", "title", "bodyParagraph", "keyTakeawayPill"],
      "properties": {
        "stepBadge": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "bodyParagraph": { "$ref": "#/$defs/text" },
        "keyTakeawayPill": { "$ref": "#/$defs/text" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/text" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "itemType", "difficulty", "plainPrompt", "prompt", "options"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]{3}$"
        },
        "itemType": {
          "enum": ["mcq", "scenario", "spotTheIssue"]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "plainPrompt": { "$ref": "#/$defs/text" },
        "prompt": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "estimatedMinutes",
        "hook",
        "declicCard",
        "microSlides",
        "keyIdeas",
        "workedExample",
        "practice",
        "questions",
        "recap",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/text" },
        "objective": { "$ref": "#/$defs/text" },
        "estimatedMinutes": { "type": "integer", "minimum": 3, "maximum": 30 },
        "hook": { "$ref": "#/$defs/text" },
        "declicCard": { "$ref": "#/$defs/declicCard" },
        "microSlides": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/microSlide" }
        },
        "keyIdeas": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "workedExample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["situation", "steps", "decision"],
          "properties": {
            "situation": { "$ref": "#/$defs/text" },
            "steps": { "$ref": "#/$defs/texts" },
            "decision": { "$ref": "#/$defs/text" }
          }
        },
        "practice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt", "successCriteria", "feedback"],
          "properties": {
            "prompt": { "$ref": "#/$defs/text" },
            "successCriteria": { "$ref": "#/$defs/texts" },
            "feedback": { "$ref": "#/$defs/text" }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/question" }
        },
        "recap": { "$ref": "#/$defs/text" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unitNumber",
        "title",
        "subtitle",
        "estimatedMinutes",
        "memoActivity",
        "memoKeyTopics",
        "memoGoldenRule",
        "architectureSchema",
        "lessons"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "unitNumber": { "type": "integer", "minimum": 1, "maximum": 10 },
        "title": { "$ref": "#/$defs/text" },
        "subtitle": { "$ref": "#/$defs/text" },
        "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 90 },
        "memoActivity": { "$ref": "#/$defs/text" },
        "memoKeyTopics": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "memoGoldenRule": { "$ref": "#/$defs/text" },
        "architectureSchema": { "$ref": "#/$defs/architectureSchema" },
        "lessons": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/lesson" }
        }
      }
    }
  }
}
