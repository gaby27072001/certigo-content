{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigo.microsoft.com/schemas/content-radar-tracks.schema.json",
  "title": "Certigo Content Radar flagship international tracks catalog",
  "description": "Closed catalog of flagship international tracks discovered and verified via the 35-provider Content Radar. Validated offline and kept outside backend-embedded release schemas until multi-provider expand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "asOf", "freshness", "tracks"],
  "properties": {
    "schema": {
      "const": "certigo.content-radar-tracks/v1"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAgeDays", "reviewDueOn"],
      "properties": {
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "reviewDueOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "$defs": {
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "weightPercent", "weightType"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(domain|section)-[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "weightPercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "weightType": {
          "enum": ["exact", "approximate"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "httpStatus"],
      "properties": {
        "kind": {
          "enum": ["certification-page", "exam-guide", "learning-path", "lifecycle"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "httpStatus": {
          "const": 200
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerId",
        "slug",
        "officialCode",
        "title",
        "category",
        "kind",
        "level",
        "status",
        "runtimeCatalogId",
        "officialUrl",
        "blueprint",
        "lifecycle",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "providerId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "officialCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "cloud-hyperscalers",
            "ai-foundation-models",
            "apple-mobile",
            "data-analytics",
            "devops-cloud-native-dev",
            "cybersecurity-networking",
            "enterprise-delivery"
          ]
        },
        "kind": {
          "enum": ["certification", "training"]
        },
        "level": {
          "enum": ["foundational", "associate", "professional", "specialty"]
        },
        "status": {
          "enum": ["announced", "active", "active-retiring"]
        },
        "runtimeCatalogId": {
          "type": ["string", "null"],
          "pattern": "^(aws|gcp|microsoft):[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "officialUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "blueprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "objectives"],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            },
            "objectives": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/objective"
              }
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transition", "note"],
          "properties": {
            "transition": {
              "enum": ["announced", "none-announced"]
            },
            "reviewOn": {
              "type": "string",
              "format": "date"
            },
            "lastExamOn": {
              "type": "string",
              "format": "date"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkedOn", "sources"],
          "properties": {
            "checkedOn": {
              "type": "string",
              "format": "date"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        }
      }
    }
  }
}
