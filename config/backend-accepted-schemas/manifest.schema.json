{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigo.example/schemas/manifest.schema.json",
  "title": "Certigo Content Manifest",
  "description": "Immutable, hash-addressable manifest. Accepts legacy v1, catalog-aware v2, and canonical runtime v3.",
  "oneOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" },
    { "$ref": "#/$defs/v3" }
  ],
  "$defs": {
    "baseProperties": {
      "algorithm": { "const": "sha256" },
      "canonicalization": { "type": "string", "minLength": 1 },
      "itemCount": { "type": "integer", "minimum": 0 },
      "manifestId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "rootHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "v1Item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "id", "path", "hash", "size"],
      "properties": {
        "channel": { "enum": ["public", "answerKey"] },
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^content/" },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "v2Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "id",
        "path",
        "resourceType",
        "hash",
        "size"
      ],
      "properties": {
        "channel": { "enum": ["public", "answerKey"] },
        "id": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^content/(public/(questions|catalog|coverage)|answerKey/solutions)/"
        },
        "resourceType": {
          "enum": [
            "question",
            "solution",
            "certificationCatalog",
            "coverageMatrix"
          ]
        },
        "provider": { "enum": ["aws", "gcp", "microsoft"] },
        "certification": {
          "type": "string",
          "pattern": "^(aws|gcp|microsoft):[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "blueprintVersion": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "objective": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "v3Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "id",
        "path",
        "resourceType",
        "hash",
        "size"
      ],
      "properties": {
        "channel": { "enum": ["public", "answerKey"] },
        "id": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^content/(public/(questions|catalog|coverage|runtime/(tracks|domains|units|lessons|concepts))|answerKey/solutions)/"
        },
        "resourceType": {
          "enum": [
            "question",
            "solution",
            "certificationCatalog",
            "coverageMatrix",
            "track",
            "domain",
            "unit",
            "lesson",
            "concept"
          ]
        },
        "provider": { "enum": ["aws", "gcp", "microsoft"] },
        "certification": {
          "type": "string",
          "pattern": "^(aws|gcp|microsoft):[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "blueprintVersion": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "objective": {
          "type": "string",
          "pattern": "^(domain|section)-[1-9][0-9]*$"
        },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "channel": { "const": "public" } },
            "required": ["channel"]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^content/public/"
              },
              "resourceType": {
                "not": { "const": "solution" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "channel": { "const": "answerKey" } },
            "required": ["channel"]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^content/answerKey/solutions/"
              },
              "resourceType": {
                "const": "solution"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "question" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "pattern": "^content/public/questions/" }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "solution" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "pattern": "^content/answerKey/solutions/" }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "certificationCatalog" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "const": "content/public/catalog/certifications.json" }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "coverageMatrix" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "pattern": "^content/public/coverage/" }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "track" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "pattern": "^content/public/runtime/tracks/" }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "domain" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "pattern": "^content/public/runtime/domains/" }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "unit" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "pattern": "^content/public/runtime/units/" }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "lesson" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "pattern": "^content/public/runtime/lessons/" }
            }
          }
        },
        {
          "if": {
            "properties": { "resourceType": { "const": "concept" } },
            "required": ["resourceType"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "pattern": "^content/public/runtime/concepts/" }
            }
          }
        }
      ]
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "algorithm",
        "canonicalization",
        "itemCount",
        "items",
        "manifestId",
        "rootHash"
      ],
      "properties": {
        "schema": { "const": "certigo.content.manifest/v1" },
        "algorithm": { "$ref": "#/$defs/baseProperties/algorithm" },
        "canonicalization": { "$ref": "#/$defs/baseProperties/canonicalization" },
        "itemCount": { "$ref": "#/$defs/baseProperties/itemCount" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/v1Item" }
        },
        "manifestId": { "$ref": "#/$defs/baseProperties/manifestId" },
        "rootHash": { "$ref": "#/$defs/baseProperties/rootHash" }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "algorithm",
        "canonicalization",
        "itemCount",
        "items",
        "manifestId",
        "rootHash"
      ],
      "properties": {
        "schema": { "const": "certigo.content.manifest/v2" },
        "algorithm": { "$ref": "#/$defs/baseProperties/algorithm" },
        "canonicalization": { "$ref": "#/$defs/baseProperties/canonicalization" },
        "itemCount": { "$ref": "#/$defs/baseProperties/itemCount" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/v2Item" }
        },
        "manifestId": { "$ref": "#/$defs/baseProperties/manifestId" },
        "rootHash": { "$ref": "#/$defs/baseProperties/rootHash" }
      }
    },
    "v3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "algorithm",
        "canonicalization",
        "itemCount",
        "items",
        "manifestId",
        "rootHash"
      ],
      "properties": {
        "schema": { "const": "certigo.content.manifest/v3" },
        "algorithm": { "$ref": "#/$defs/baseProperties/algorithm" },
        "canonicalization": { "$ref": "#/$defs/baseProperties/canonicalization" },
        "itemCount": { "$ref": "#/$defs/baseProperties/itemCount" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/v3Item" }
        },
        "manifestId": { "$ref": "#/$defs/baseProperties/manifestId" },
        "rootHash": { "$ref": "#/$defs/baseProperties/rootHash" }
      }
    }
  }
}
